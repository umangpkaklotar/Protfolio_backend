# ==============================================================================
# Umang P. Kaklotar's Portfolio Backend Environment Configuration
# ==============================================================================

# Google Gemini API Key (Required for live RAG generation)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name for Generation (default: gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# Gemini Embedding Model (default: gemini-embedding-2)
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Pinecone Vector Database Configuration
# Get your API key at: https://app.pinecone.io/
PINECONE=your_pinecone_api_key_here
PINECONE_INDEX_NAME=portfolio-knowledge
PINECONE_NAMESPACE=portfolio
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# FastAPI Server Host & Port
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (comma-separated for frontend communication)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
