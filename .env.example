# ==============================================================================
# Umang P. Kaklotar's Portfolio Backend Environment Configuration
# ==============================================================================

# Google Gemini API Key (Required for live RAG generation)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name for Generation (default: gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# Gemini Embedding Model (default: gemini-embedding-2)
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# ChromaDB Vector Database Configuration
# Directory path for persistent storage (relative to backend/ or absolute path)
CHROMA_DB_DIR=chroma_db
CHROMA_COLLECTION_NAME=portfolio_knowledge

# FastAPI Server Host & Port
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (comma-separated for frontend communication)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
